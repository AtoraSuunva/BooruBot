{
  "name": "boorubot",
  "version": "4.9.0",
  "description": "A Discord bot to search boorus",
  "keywords": [],
  "homepage": "https://github.com/AtoraSuunva/BooruBot#readme",
  "bugs": {
    "url": "https://github.com/AtoraSuunva/BooruBot/issues"
  },
  "license": "MIT",
  "author": "AtoraSuunva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtoraSuunva/BooruBot.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "tsc --build && node --env-file=.env --enable-source-maps --trace-warnings dist/index.js",
    "start:dist": "node --env-file=.env --enable-source-maps --trace-warnings dist/index.js",
    "start:prod": "prisma migrate deploy && node --enable-source-maps dist/index.js",
    "generate": "prisma generate",
    "build": "tsgo --build",
    "check": "pnpm run '/.*:check/'",
    "fix": "pnpm run '/.*:fix/'",
    "lint:check": "oxlint",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt --write",
    "prisma:fix": "prisma format",
    "sentry:sourcemaps:inject": "sentry-cli sourcemaps inject ./dist",
    "sentry:sourcemaps:upload": "sentry-cli sourcemaps upload ./dist"
  },
  "dependencies": {
    "@plus99/murmur-hash": "^1.0.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/instrumentation": "^7.8.0",
    "@prisma/sqlcommenter-query-tags": "^7.8.0",
    "@types/pluralize": "^0.0.33",
    "better-sqlite3": "^12.10.0",
    "booru": "^2.9.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "magic-bytes.js": "^1.13.0",
    "pino": "^10.3.1",
    "pino-dev": "^4.0.3",
    "pluralize": "^8.0.0",
    "pretty-ms": "^9.3.0",
    "prisma": "^7.8.0",
    "sleetcord": "^4.2.0",
    "sleetcord-common": "^16.0.3",
    "string-width": "^8.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@sentry/cli": "^3.5.0",
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260607.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
